{
  "trading-system-task-policy": {
    "Version": "2012-10-17",
    "Statement": [
      {
        "Sid": "DynamoDBAccess",
        "Effect": "Allow",
        "Action": [
          "dynamodb:GetItem",
          "dynamodb:PutItem",
          "dynamodb:UpdateItem",
          "dynamodb:Query",
          "dynamodb:Scan",
          "dynamodb:BatchGetItem",
          "dynamodb:BatchWriteItem"
        ],
        "Resource": [
          "arn:aws:dynamodb:*:*:table/mcelveen-oauth-tokens",
          "arn:aws:dynamodb:*:*:table/mcelveen-trades-table",
          "arn:aws:dynamodb:*:*:table/mcelveen-positions-snapshot"
        ]
      },
      {
        "Sid": "CloudWatchLogs",
        "Effect": "Allow",
        "Action": [
          "logs:CreateLogGroup",
          "logs:CreateLogStream",
          "logs:PutLogEvents"
        ],
        "Resource": "arn:aws:logs:*:*:*"
      },
      {
        "Sid": "ECRAccess",
        "Effect": "Allow",
        "Action": [
          "ecr:GetAuthorizationToken"
        ],
        "Resource": "*"
      }
    ]
  },

  "daily-report-task-policy": {
    "Version": "2012-10-17",
    "Statement": [
      {
        "Sid": "DynamoDBRead",
        "Effect": "Allow",
        "Action": [
          "dynamodb:GetItem",
          "dynamodb:Query",
          "dynamodb:Scan",
          "dynamodb:BatchGetItem"
        ],
        "Resource": [
          "arn:aws:dynamodb:*:*:table/mcelveen-oauth-tokens",
          "arn:aws:dynamodb:*:*:table/mcelveen-trades-table",
          "arn:aws:dynamodb:*:*:table/mcelveen-positions-snapshot"
        ]
      },
      {
        "Sid": "SNSPublish",
        "Effect": "Allow",
        "Action": [
          "sns:Publish"
        ],
        "Resource": "arn:aws:sns:*:*:mcelveen-daily-report"
      },
      {
        "Sid": "CloudWatchLogs",
        "Effect": "Allow",
        "Action": [
          "logs:CreateLogGroup",
          "logs:CreateLogStream",
          "logs:PutLogEvents"
        ],
        "Resource": "arn:aws:logs:*:*:*"
      },
      {
        "Sid": "ECRAccess",
        "Effect": "Allow",
        "Action": [
          "ecr:GetAuthorizationToken"
        ],
        "Resource": "*"
      }
    ]
  },

  "token-refresh-task-policy": {
    "Version": "2012-10-17",
    "Statement": [
      {
        "Sid": "DynamoDBAccess",
        "Effect": "Allow",
        "Action": [
          "dynamodb:GetItem",
          "dynamodb:PutItem",
          "dynamodb:UpdateItem"
        ],
        "Resource": "arn:aws:dynamodb:*:*:table/mcelveen-oauth-tokens"
      },
      {
        "Sid": "CloudWatchLogs",
        "Effect": "Allow",
        "Action": [
          "logs:CreateLogGroup",
          "logs:CreateLogStream",
          "logs:PutLogEvents"
        ],
        "Resource": "arn:aws:logs:*:*:*"
      },
      {
        "Sid": "ECRAccess",
        "Effect": "Allow",
        "Action": [
          "ecr:GetAuthorizationToken"
        ],
        "Resource": "*"
      }
    ]
  },

  "eventbridge-ecs-role-policy": {
    "Version": "2012-10-17",
    "Statement": [
      {
        "Sid": "PassRole",
        "Effect": "Allow",
        "Action": [
          "iam:PassRole"
        ],
        "Resource": [
          "arn:aws:iam::*:role/ecsTaskExecutionRole",
          "arn:aws:iam::*:role/mcelveen-*-task-role"
        ]
      },
      {
        "Sid": "ECSRunTask",
        "Effect": "Allow",
        "Action": [
          "ecs:RunTask"
        ],
        "Resource": [
          "arn:aws:ecs:*:*:task-definition/mcelveen-*"
        ]
      }
    ]
  }
}
