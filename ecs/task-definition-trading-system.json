{
  "family": "mcelveen-trading-system",
  "networkMode": "awsvpc",
  "requiresCompatibilities": ["FARGATE"],
  "cpu": "512",
  "memory": "1024",
  "containerDefinitions": [
    {
      "name": "trading-system",
      "image": "${AWS_ACCOUNT_ID}.dkr.ecr.${AWS_REGION}.amazonaws.com/mcelveen-trading-system:latest",
      "essential": true,
      "portMappings": [
        {
          "containerPort": 8080,
          "hostPort": 8080,
          "protocol": "tcp"
        }
      ],
      "environment": [
        {
          "name": "AWS_REGION",
          "value": "us-east-1"
        },
        {
          "name": "PYTHON_LOG_LEVEL",
          "value": "INFO"
        },
        {
          "name": "OAUTH_TOKENS_TABLE",
          "value": "mcelveen-oauth-tokens"
        },
        {
          "name": "TRADE_JOURNAL_TABLE",
          "value": "mcelveen-trades-table"
        },
        {
          "name": "EXECUTION_LOG_TABLE",
          "value": "mcelveen-execution-log"
        },
        {
          "name": "PORTFOLIO_METRICS_TABLE",
          "value": "mcelveen-portfolio-metrics"
        },
        {
          "name": "POSITIONS_SNAPSHOT_TABLE",
          "value": "mcelveen-positions-snapshot"
        },
        {
          "name": "TRADING_STRATEGY",
          "value": "HYBRID"
        },
        {
          "name": "AUTONOMOUS_MODE_ENABLED",
          "value": "true"
        },
        {
          "name": "WEEKLY_DEPOSIT_ENABLED",
          "value": "true"
        },
        {
          "name": "WEEKLY_DEPOSIT_AMOUNT",
          "value": "2500"
        },
        {
          "name": "ENABLE_CACHE",
          "value": "true"
        },
        {
          "name": "CLAUDE_MODEL",
          "value": "claude-opus-5-5"
        }
      ],
      "secrets": [
        {
          "name": "SCHWAB_ACCOUNT_ID",
          "valueFrom": "arn:aws:secretsmanager:${AWS_REGION}:${AWS_ACCOUNT_ID}:secret:mcelveen/schwab/account-id"
        },
        {
          "name": "SCHWAB_CLIENT_ID",
          "valueFrom": "arn:aws:secretsmanager:${AWS_REGION}:${AWS_ACCOUNT_ID}:secret:mcelveen/schwab/client-id"
        },
        {
          "name": "SCHWAB_CLIENT_SECRET",
          "valueFrom": "arn:aws:secretsmanager:${AWS_REGION}:${AWS_ACCOUNT_ID}:secret:mcelveen/schwab/client-secret"
        },
        {
          "name": "SCHWAB_REFRESH_TOKEN",
          "valueFrom": "arn:aws:secretsmanager:${AWS_REGION}:${AWS_ACCOUNT_ID}:secret:mcelveen/schwab/refresh-token"
        },
        {
          "name": "CLAUDE_API_KEY",
          "valueFrom": "arn:aws:secretsmanager:${AWS_REGION}:${AWS_ACCOUNT_ID}:secret:mcelveen/claude/api-key"
        },
        {
          "name": "SNS_TOPIC_ARN",
          "valueFrom": "arn:aws:secretsmanager:${AWS_REGION}:${AWS_ACCOUNT_ID}:secret:mcelveen/sns/topic-arn"
        },
        {
          "name": "ALERT_EMAIL",
          "valueFrom": "arn:aws:secretsmanager:${AWS_REGION}:${AWS_ACCOUNT_ID}:secret:mcelveen/alerts/email"
        }
      ],
      "logConfiguration": {
        "logDriver": "awslogs",
        "options": {
          "awslogs-group": "/ecs/mcelveen-trading-system",
          "awslogs-region": "${AWS_REGION}",
          "awslogs-stream-prefix": "ecs"
        }
      },
      "healthCheck": {
        "command": ["CMD-SHELL", "curl -f http://localhost:8080/health || exit 1"],
        "interval": 30,
        "timeout": 5,
        "retries": 3,
        "startPeriod": 60
      }
    }
  ],
  "executionRoleArn": "arn:aws:iam::${AWS_ACCOUNT_ID}:role/ecsTaskExecutionRole",
  "taskRoleArn": "arn:aws:iam::${AWS_ACCOUNT_ID}:role/mcelveen-trading-system-task-role",
  "tags": [
    {
      "key": "Service",
      "value": "Trading-System"
    },
    {
      "key": "Environment",
      "value": "Production"
    }
  ]
}
