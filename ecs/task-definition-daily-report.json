{
  "family": "mcelveen-daily-report",
  "networkMode": "awsvpc",
  "requiresCompatibilities": ["FARGATE"],
  "cpu": "256",
  "memory": "512",
  "containerDefinitions": [
    {
      "name": "daily-report",
      "image": "${AWS_ACCOUNT_ID}.dkr.ecr.${AWS_REGION}.amazonaws.com/mcelveen-daily-report:latest",
      "essential": true,
      "portMappings": [
        {
          "containerPort": 8080,
          "hostPort": 8080,
          "protocol": "tcp"
        }
      ],
      "environment": [
        {
          "name": "AWS_REGION",
          "value": "us-east-1"
        },
        {
          "name": "PYTHON_LOG_LEVEL",
          "value": "INFO"
        },
        {
          "name": "DYNAMODB_OAUTH_TABLE",
          "value": "mcelveen-oauth-tokens"
        },
        {
          "name": "DYNAMODB_TRADES_TABLE",
          "value": "mcelveen-trades-table"
        },
        {
          "name": "DYNAMODB_POSITIONS_TABLE",
          "value": "mcelveen-positions-snapshot"
        },
        {
          "name": "SECURITIES_LENDING_ELIGIBLE",
          "value": "false"
        },
        {
          "name": "SECURITIES_LENDING_ENROLLED",
          "value": "false"
        }
      ],
      "secrets": [
        {
          "name": "SCHWAB_ACCOUNT_ID",
          "valueFrom": "arn:aws:secretsmanager:${AWS_REGION}:${AWS_ACCOUNT_ID}:secret:mcelveen/schwab/account-id"
        },
        {
          "name": "SCHWAB_CLIENT_ID",
          "valueFrom": "arn:aws:secretsmanager:${AWS_REGION}:${AWS_ACCOUNT_ID}:secret:mcelveen/schwab/client-id"
        },
        {
          "name": "SCHWAB_CLIENT_SECRET",
          "valueFrom": "arn:aws:secretsmanager:${AWS_REGION}:${AWS_ACCOUNT_ID}:secret:mcelveen/schwab/client-secret"
        },
        {
          "name": "SNS_TOPIC_ARN",
          "valueFrom": "arn:aws:secretsmanager:${AWS_REGION}:${AWS_ACCOUNT_ID}:secret:mcelveen/sns/topic-arn"
        },
        {
          "name": "ALERT_EMAIL",
          "valueFrom": "arn:aws:secretsmanager:${AWS_REGION}:${AWS_ACCOUNT_ID}:secret:mcelveen/alerts/email"
        }
      ],
      "logConfiguration": {
        "logDriver": "awslogs",
        "options": {
          "awslogs-group": "/ecs/mcelveen-daily-report",
          "awslogs-region": "${AWS_REGION}",
          "awslogs-stream-prefix": "ecs"
        }
      },
      "healthCheck": {
        "command": ["CMD-SHELL", "curl -f http://localhost:8080/health || exit 1"],
        "interval": 30,
        "timeout": 5,
        "retries": 3,
        "startPeriod": 60
      }
    }
  ],
  "executionRoleArn": "arn:aws:iam::${AWS_ACCOUNT_ID}:role/ecsTaskExecutionRole",
  "taskRoleArn": "arn:aws:iam::${AWS_ACCOUNT_ID}:role/mcelveen-daily-report-task-role",
  "tags": [
    {
      "key": "Service",
      "value": "Daily-Report"
    },
    {
      "key": "Environment",
      "value": "Production"
    }
  ]
}
